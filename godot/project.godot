config_version=5

[application]
config/name="CAUSEWAYBAY DRONE"
run/main_scene="res://scenes/main.tscn"

[audio]
general/text_to_speech=true

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[gui]
theme/custom_font="res://assets/fonts/game-ui.tres"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.65,0.8,0.87,1)

lights_and_shadows/directional_shadow/size=2048

scaling_3d/mode=2
scaling_3d/scale=0.8
